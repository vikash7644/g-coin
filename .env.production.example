# Production environment example for G-COIN

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Session signing secret (generate securely)
AUTH_SECRET="replace_with_a_strong_random_secret"

# Redis for worker/queue
REDIS_URL="redis://:PASSWORD@redis-host:6379"

# AWS S3 (for screenshots/uploads)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="your-gcoin-bucket"

# SMTP (SendGrid, Resend, SMTP provider)
SMTP_URL="smtp://USER:PASSWORD@smtp.provider.com:587"

# App settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL="https://your-gcoin-app.example"
